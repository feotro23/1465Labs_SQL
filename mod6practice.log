mysql> DELIMITER $$
mysql> CREATE PROCEDURE AddNewMember(
    ->     IN p_FirstName VARCHAR(50),
    ->     IN p_LastName  VARCHAR(50),
    ->     IN p_JoinDate  DATE
    -> )
    -> BEGIN
    ->     INSERT INTO Member (FirstName, LastName, JoinDate, ClassesAttended)
    ->     VALUES (p_FirstName, p_LastName, p_JoinDate, 0);
    -> 
    ->     SELECT * FROM Member
    ->     WHERE MemberID = LAST_INSERT_ID();
    -> END $$
Query OK, 0 rows affected (0.01 sec)

