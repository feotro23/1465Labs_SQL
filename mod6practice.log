mysql> DELIMITER $$
mysql> CREATE PROCEDURE CancelMembership(IN p_MemberID INT)
    -> BEGIN
    ->     IF EXISTS (SELECT 1 FROM Member WHERE MemberID = p_MemberID) THEN
    ->         SELECT FirstName, LastName, MemberTier(ClassesAttended) AS Tier
    ->         FROM Member
    ->         WHERE MemberID = p_MemberID;
    -> 
    ->         DELETE FROM Member WHERE MemberID = p_MemberID;
    -> 
    ->         SELECT CONCAT('Member ', p_MemberID, ' has been removed. Sorry to see you go!') AS Message;
    ->     ELSE
    ->         SELECT CONCAT('No member found with ID ', p_MemberID, '. Nothing was deleted.') AS Message;
    ->     END IF;
    -> END $$
Query OK, 0 rows affected (0.00 sec)

