mysql> DELIMITER $$
mysql> CREATE FUNCTION ClassDiscount(Tier VARCHAR(10))
    -> RETURNS DECIMAL(4,2)
    -> DETERMINISTIC
    -> BEGIN
    ->     DECLARE Discount DECIMAL(4,2);
    ->     IF Tier = 'Gold' THEN
    ->         SET Discount = 0.20;
    ->     ELSEIF Tier = 'Silver' THEN
    ->         SET Discount = 0.10;
    ->     ELSE
    ->         SET Discount = 0.00;
    ->     END IF;
    ->     RETURN Discount;
    -> END $$
Query OK, 0 rows affected (0.01 sec)

